# =============================================================================
# TechAI API — Environment Variables
# Copy this file to .env and fill in real values before running the app.
# =============================================================================

# --- App ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:3000

# --- Database (PostgreSQL) ----------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/techai?schema=public"

# --- JWT -----------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret-please-use-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-please-use-a-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

# --- Security --------------------------------------------------------------
BCRYPT_SALT_ROUNDS=12
COOKIE_SECRET=change-me-cookie-secret-please-use-a-long-random-string
COOKIE_DOMAIN=

# --- Rate limiting (window in seconds, requests per window) ---------------
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# --- OAuth: Google ---------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# --- OAuth: GitHub ----------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/v1/auth/github/callback

# --- Mail --------------------------------------------------------------
MAIL_FROM="TechAI <no-reply@techai.com>"
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Redis (caching / queues) ------------------------------------------
REDIS_URL=redis://localhost:6379

# --- AWS S3 (file storage) ------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=techai-uploads

# --- Cloudinary (media storage) ------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Payments --------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- OpenAI ------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Uploads (driver: cloudinary | s3 | local) ------------------------------
UPLOADS_DRIVER=local

# --- Seed accounts (used by prisma/seed/index.ts) --------------------------
SEED_SUPER_ADMIN_EMAIL=admin@techai.com
SEED_SUPER_ADMIN_PASSWORD=Admin@12345
